# message_pusher configuration -- copy to .env and edit. Never commit .env.
# Everything here is read from the process environment (twelve-factor).

# --- identity ---------------------------------------------------------------
APP_ENV=development
# Required when APP_ENV=production; the app refuses to start without it.
SECRET_KEY=change-me-in-production

# --- HTTP -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
MAX_CONTENT_LENGTH=8388608

# --- storage ----------------------------------------------------------------
# Leave empty to use the bundled sqlite database under var/instance.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/message_pusher
DATA_DIR=
INSTANCE_DIR=
LOG_DIR=

# --- observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID

# PUSHER_URL is read by the CLI, not by the web process; it defaults to
# http://127.0.0.1:8000 and can also be passed as --url.
PUSHER_URL=http://127.0.0.1:8000
